# Every course URL serves the same page; it reads the slug from the path.
# 200 = rewrite, so the address bar keeps the real course URL.
/c/*    /c/index.html    200

# Same pattern for participant manuals. The page reads brand and level
# from the path, e.g. /manuals/tgc-l1/ so adding a new manual is a
# database row rather than a new page.
/manuals/*    /manuals/index.html    200

# Blog posts work the same way: /blog/<slug>/ serves one page that
# reads the slug and fetches that post. The list at /blog/ is a real
# file, so it is matched first and never reaches this rule.
/blog/*    /blog/post/index.html    200

# BirdBox Learn: course package files (Rise SCORM exports) are stored in
# the Supabase "learn" bucket but must load from our own address, or the
# course cannot find the SCORM player around it. 200 = rewrite, so the
# browser only ever sees birdboxcoaching.com. HTML files are caught first
# by netlify/functions/learn-file.mjs, which serves them as real pages.
/learn/c/*    https://yvdmazpxtpuvidlcifnq.supabase.co/storage/v1/object/public/learn/:splat    200

# Trainer directory: each coach has their own address,
# /trainer-directory/coach/<slug>, all served by one page that reads the
# slug from the path. Their details come from directory-public.
/trainer-directory/coach/*    /trainer-directory/coach/index.html    200

# A coach's listing is edited inside BirdBox Learn, with the same login
# as their online courses. These catch the obvious guesses.
/trainer-directory/join    /learn/directory/    301
/trainer-directory/me      /learn/directory/    301
/trainer-directory/me/     /learn/directory/    301

# The merch store became the Shop (gift cards first, then apparel).
/merch     /shop/    301
/merch/*   /shop/    301
